# =============================================================================
# Vexride — Variables de entorno
# Copia a .env.local, rellena valores REALES y sube a Vercel con:
#   ./scripts/vercel-env.sh checklist   # guía paso a paso
#   ./scripts/vercel-env.sh push        # sync con Vercel CLI
# =============================================================================

# --- App (obligatorio en producción) ---
# URL pública del deploy (Vercel → Settings → Domains)
NEXT_PUBLIC_APP_URL=https://tu-proyecto.vercel.app

# --- Clerk Authentication ---
# Dashboard: https://dashboard.clerk.com → tu app → Configure → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rutas internas (copiar tal cual)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Webhook: Clerk → Webhooks → https://TU-DOMINIO/api/webhooks/clerk
# Eventos: user.created, user.updated
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase ---
# Dashboard: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role — SOLO servidor (Vercel env, nunca NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Stripe ---
# Dashboard: https://dashboard.stripe.com → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook: Developers → Webhooks → https://TU-DOMINIO/api/webhooks/stripe
# Eventos: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Price IDs: Product catalog → Starter $29, Pro $69, Enterprise $199
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxxx

# --- Vex AI / OpenAI (opcional) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Maps (opcional — Leaflet/OSM funciona sin key en demo) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# =============================================================================
# Deploy Vercel (Root Directory = vexride)
# =============================================================================
# 1. cp .env.example .env.local  → rellena con ./scripts/vercel-env.sh checklist
# 2. npm i -g vercel && cd vexride && vercel link
# 3. ./scripts/vercel-env.sh validate && ./scripts/vercel-env.sh push
# 4. vercel --prod
# 5. Supabase: ejecutar supabase/schema.sql + migrations/
# 6. Clerk: JWT template "supabase" + dominio Vercel en allowed origins
# 7. Smoke test: curl https://TU-DOMINIO/api/health
# =============================================================================
